APP_VERSION=v0.5.1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_DAYS=30
ADAPTER_API_KEY=replace-with-a-new-api-channel-key
ENCRYPTION_KEY=replace-with-a-fernet-key
HOST=0.0.0.0
PORT=8787
# Customer-facing New API address used in exported integration documents.
API_PUBLIC_BASE_URL=https://zl.yyapi.cloud
# Middleware address used by its own admin/workbench routes. Do not give it to customers.
PUBLIC_BASE_URL=https://video-admin.example.com
NEW_API_PUBLIC_BASE_URL=https://media.yyapi.cloud
# Fixed New API target for the workbench video gateway; accessed server-side only.
NEW_API_GATEWAY_BASE_URL=https://zl.yyapi.cloud
NEW_API_GATEWAY_TIMEOUT_SECONDS=930
WORKBENCH_ORIGIN=https://image.yyapi.cloud
COOKIE_SECURE=false
UPSTREAM_TIMEOUT_SECONDS=60
IMAGE_UPSTREAM_TIMEOUT_SECONDS=360
DATA_DIR=./data
# Public address the generated image links are advertised under. Defaults to
# PUBLIC_BASE_URL; set it when PUBLIC_BASE_URL is a loopback address.
IMAGE_PUBLIC_BASE_URL=https://video-admin.yyapi.cloud
# Stored generated images: bytes live under IMAGE_STORAGE_DIR and expire
# IMAGE_ASSET_RETENTION_HOURS after creation. The size ceiling evicts the oldest
# images first, and writes stop once free disk space drops below
# IMAGE_STORAGE_MIN_FREE_GB. IMAGE_CLEANUP_INTERVAL_SECONDS controls how often
# expired files, orphaned files and old request logs are swept.
IMAGE_STORAGE_DIR=image-assets
IMAGE_ASSET_RETENTION_HOURS=24
IMAGE_REQUEST_LOG_RETENTION_HOURS=72
IMAGE_STORAGE_MAX_GB=100
IMAGE_STORAGE_MIN_FREE_GB=5
IMAGE_CLEANUP_INTERVAL_SECONDS=600
# A reply larger than this is refused instead of being buffered, which is what
# bounds the middleware's peak memory (roughly three times the reply size).
IMAGE_MAX_RESPONSE_MB=128
# Video task and audit history (tasks / audit_requests / audit_events) is
# trimmed on the same cadence; only settled work is removed, and a request
# whose public video link is still alive is kept until that link expires.
HISTORY_RETENTION_HOURS=72
